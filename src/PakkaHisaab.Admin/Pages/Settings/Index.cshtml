@page "/Settings"
@model PakkaHisaab.Admin.Pages.Settings.IndexModel
@{ ViewData["PageTitle"] = "Settings"; }

<div class="ph-card" style="max-width:640px">
    <div class="ph-card-header"><h2>Automatic Translation</h2></div>
    <div class="ph-card-body">
        <p class="text-secondary small">
            When enabled, helper names, ledger notes and account names typed in any language
            are machine-translated to English for display across the Admin console (Dashboard,
            Helpers, Ledger, Settlements, Users). Off by default — this makes an external call
            per new or changed entry, so it's opt-in.
        </p>

        <form method="post">
            <div class="form-check form-switch mb-3">
                <input asp-for="Input.Enabled" class="form-check-input" role="switch" />
                <label asp-for="Input.Enabled" class="form-check-label fw-semibold">Enable automatic translation</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Provider</label>
                <select asp-for="Input.Provider" class="form-select">
                    <option value="GoogleFree">Free Google Translate (no cost, unofficial, no key needed)</option>
                    <option value="GoogleCloud">Google Cloud Translation (official, paid, needs an API key)</option>
                </select>
                <div class="form-text">
                    <strong>Free Google Translate</strong> uses the same public endpoint behind
                    translate.google.com — no signup, no cost, but it's not an officially
                    supported API and Google can rate-limit or change it without notice.
                    <br />
                    <strong>Google Cloud Translation</strong> is the supported, paid API
                    (2026 pricing: ~500K characters/month free, then ~$20 per million) — requires
                    <code>GoogleTranslate:ApiKey</code> to be configured on the API app; without
                    it, this option silently does nothing.
                </div>
            </div>

            <button type="submit" class="btn btn-ph-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
        </form>
    </div>
</div>
